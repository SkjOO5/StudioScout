# ─────────────────────────────────────────────────────────────────────────────
# StudioScout AI — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Google AI / Gemini ───────────────────────────────────────────────────────
# Option A: Google AI Studio (simplest for local development)
#   Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Option B: Google Cloud / Vertex AI (for production deployment)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini model to use (configurable — don't hardcode in source)
GEMINI_MODEL=gemini-3.1-flash

# ─── Parallel Search ──────────────────────────────────────────────────────────
# Get your API key at: https://platform.parallel.ai
# The Parallel track REQUIRES this to be set for the hackathon demo.
PARALLEL_API_KEY=your_parallel_api_key_here
# Processor tier: base or pro
PARALLEL_PROCESSOR=base

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Set to true for verbose logging
DEBUG=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
